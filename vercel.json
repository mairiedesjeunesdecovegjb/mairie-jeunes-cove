{
  "buildCommand": "pnpm install && pnpm --filter @workspace/mairie-jeunes-cove run build",
  "outputDirectory": "artifacts/mairie-jeunes-cove/dist",
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/google8dcbea91ab0f9a5b.html", "destination": "/google8dcbea91ab0f9a5b.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
